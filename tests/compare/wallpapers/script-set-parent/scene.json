      "text": {
        "value": "report",
        "script": "'use strict';\nconst f = (v) => v === undefined ? 'undefined' : [v.x, v.y, v.z].map((n) => n.toFixed(3)).join(',');\nfunction look(name, call) {\n    const layer = thisScene.getLayer(name);\n    try { call(layer); return name + ': ' + f(layer.angles); } catch (e) { return name + ': ' + e; }\n}\nexport function update(value) {\n    const lines = [];\n    for (const name of ['kept', 'moved', 'by id']) {\n        const layer = thisScene.getLayer(name);\n        const parent = layer.getParent();\n        lines.push(name + ': parent ' + (parent ? parent.name : 'none') + ' origin ' + f(layer.origin));\n    }\n    lines.push(look('look x', (l) => l.lookAt(new Vec3(800, 900, 0))));\n    lines.push(look('look y', (l) => l.lookAt(new Vec3(300, 1280, 0))));\n    lines.push(look('look z', (l) => l.lookAt(new Vec3(300, 660, 500))));\n    lines.push(look('look up', (l) => l.lookAt(new Vec3(800, 540, 0), new Vec3(0, 0, 1))));\n    lines.push(look('yaw xz', (l) => l.lookAtYaw(new Vec3(800, 420, 500))));\n    return lines.join('\\n');\n}\n",
        "scriptproperties": {}
